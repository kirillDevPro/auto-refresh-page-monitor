{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.8.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "offscreen",
    "unlimitedStorage",
    "idle",
    "contextMenus"
  ],
  "optional_permissions": [
    "webNavigation"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "toggle-refresh": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "__MSG_command_toggle_refresh__"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "__MSG_command_toggle_pause__"
    },
    "bulk-toggle-window": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "__MSG_command_bulk_window__"
    },
    "bulk-toggle-group": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "__MSG_command_bulk_group__"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_page": "settings/settings.html"
}
